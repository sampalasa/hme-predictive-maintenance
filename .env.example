# Copy this file to .env and adjust values for your environment.

FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production

# SQLite database file (relative to project root)
DATABASE_URL=sqlite:///instance/hme.db

# Source dataset
DATASET_PATH=Datasets/Synthetic_Datasets_10_Master_Projects_10000Rows.xlsx
DATASET_SHEET_NAME=1_HME_Downtime

# ML training
ML_ARTIFACTS_DIR=app/ml/artifacts
OPTUNA_N_TRIALS=30
RANDOM_STATE=42
