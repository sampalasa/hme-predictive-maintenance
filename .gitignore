__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Database
instance/*.db
instance/*.sqlite3

# ML artifacts (regenerated by training pipeline)
app/ml/artifacts/*.joblib
app/ml/artifacts/*.json
!app/ml/artifacts/.gitkeep

# Logs
logs/*.log
!logs/.gitkeep

# Generated outputs
reports/*
exports/*
!reports/.gitkeep
!exports/.gitkeep
docs/exports/*
!docs/exports/.gitkeep

# CatBoost training artifacts (regenerated on every training run)
catboost_info/

# IDE / tooling
.vscode/
.idea/
.claude/

# OS
Thumbs.db
.DS_Store

# Office lock files (created while a .docx/.pptx is open)
~$*.docx
~$*.pptx

# Tests / tooling
.pytest_cache/
.coverage
htmlcov/
